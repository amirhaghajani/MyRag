# MyRag configuration. Copy to .env and fill in.
#
# LLM and embedding calls go to two independently configurable OpenAI-compatible
# endpoints. They may be the same host or different ones.

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/myragapp

# --- LLM endpoint ---
API_BASE=https://openrouter.ai/api/v1
API_KEY=sk-replace-me
# model_id=input_price_per_1m,output_price_per_1m,context_window ; separated by ';'
LLM_MODELS=openai/gpt-4o-mini=0.15,0.60,128000; openai/gpt-4o=2.50,10.00,128000
DEFAULT_LLM_MODEL=openai/gpt-4o-mini

# --- Embedding endpoint (separate host and key) ---
EMBED_API_BASE=https://api.openai.com/v1
EMBED_API_KEY=sk-replace-me
# model_id=dim,input_price_per_1m ; separated by ';'
# Every entry MUST have dim == EMBED_DIM or startup fails with a message naming it.
EMBED_MODELS=openai/text-embedding-3-small=1536,0.02; openai/text-embedding-ada-002=1536,0.0001
DEFAULT_EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIM=1536

# --- Retrieval defaults ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=4
MAX_UPLOAD_MB=25
MAX_CHUNKS_PER_DOC=2000

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- Login (HTTP Basic). Set both to enable, or leave both empty to disable. ---
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me