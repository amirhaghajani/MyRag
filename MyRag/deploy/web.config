<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse-proxy config for MyRag. Copy this file to the site's physical path
  (for example C:\inetpub\myrag\web.config).

  Requires IIS + URL Rewrite 2.1 + Application Request Routing (ARR) 3.0, and the
  MyRag Uvicorn process listening on http://127.0.0.1:8000.
-->
<configuration>
  <system.webServer>
    <!--
      Streaming answers arrive as Server-Sent Events. Dynamic compression buffers
      responses, so it must stay off for the proxy to pass tokens through live.
    -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <!-- Match the API's 1 GB upload ceiling. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="1073741824" />
      </requestFiltering>
    </security>

    <rewrite>
      <rules>
        <rule name="ProxyToMyRag" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:0}" />
        </rule>
      </rules>
    </rewrite>

    <!-- ARR proxy: keep the original host header. -->
    <proxy enabled="true" preserveHostHeader="true" />
  </system.webServer>
</configuration>